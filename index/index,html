const form = document.getElementById('bookingForm');
const eventNameInput = document.getElementById('eventName');
let selectedEventId = null;

function openBookingModal(id) {
    selectedEventId = id;
    const event = events.find(e => e.id === id);
    if (event) {
        eventNameInput.value = event.title + " (" + event.date + ", " + event.time + ")";
        bookingModal.style.display = 'flex';
    }
}

function closeBookingModal() {
    bookingModal.style.display = 'none';
    selectedEventId = null;
    form.reset();
}

closeModalBtn.onclick = closeBookingModal;
window.onclick = (e) => {
    if (e.target === bookingModal) closeBookingModal();
};

form.onsubmit = (e) => {
    e.preventDefault();
    const event = events.find(e => e.id === selectedEventId);
    const name = document.getElementById('userName').value;
    const phone = document.getElementById('userPhone').value;
    const participants = document.getElementById('participants').value;
    if (event && name && phone) {
        const message = encodeURIComponent(
            `Здравствуйте! Хочу записаться на мастер-класс:\n\n` +
            `🎄 ${event.title}\n` +
            `📅 Дата: ${event.date}\n` +
            `⏰ Время: ${event.time}\n` +
            `💰 Стоимость: ${event.price}\n` +
            `👤 Имя: ${name}\n` +
            `📱 Телефон: ${phone}\n` +
            `👥 Участников: ${participants}\n\n` +
            `Пожалуйста, подтвердите мою запись!`
        );
        // Открываем VK с предзаполненным сообщением
        window.open(`https://vk.com/im/channels/-234355538?message=${message}`, '_blank');
        alert('Сейчас откроется VK. Пожалуйста, отправьте сообщение для подтверждения записи!');
        closeBookingModal();
    }
};

// Навигация месяца (заглушки)
document.getElementById('prevMonth').onclick = () => alert('Переход к предыдущему месяцу (в демо-версии не реализован)');
document.getElementById('nextMonth').onclick = () => alert('Переход к следующему месяцу (в демо-версии не реализован)');

// Плавный скролл
document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.onclick = (e) => {
        e.preventDefault();
        const target = document.querySelector(link.getAttribute('href'));
        if (target) {
            window.scrollTo({ top: target.offsetTop - 80, behavior: 'smooth' });
        }
    };
});

// Инициализация
document.addEventListener('DOMContentLoaded', () => {
    renderEvents();
    
    // Добавляем случайные поп-арт элементы на страницу
    const popArtTexts = ["🎄", "🎅", "❄️", "⭐", "🎁", "✨", "🌟", "☃️"];
    const sections = document.querySelectorAll('.section');
    
    sections.forEach(section => {
        if (Math.random() > 0.5) {
            const popElement = document.createElement('div');
            popElement.className = 'pop-art-element';
            popElement.textContent = popArtTexts[Math.floor(Math.random() * popArtTexts.length)];
            popElement.style.position = 'absolute';
            popElement.style.top = Math.random() * 80 + 10 + '%';
            popElement.style.left = Math.random() * 80 + 10 + '%';
            popElement.style.transform = `rotate(${Math.random() * 60 - 30}deg)`;
            popElement.style.color = [ 'var(--muted-yellow)', 'var(--soft-yellow)', 'var(--dark-green)', 'var(--accent-red)' ][Math.floor(Math.random() * 4)];
            popElement.style.fontSize = Math.random() * 1.5 + 1 + 'rem';
            popElement.style.opacity = '0.6';
            popElement.style.zIndex = '1';
            popElement.style.pointerEvents = 'none';
            popElement.style.textShadow = '2px 2px 0 rgba(0,0,0,0.3)';
            section.style.position = 'relative';
            section.appendChild(popElement);
        }
    });
});
</script>
</body>
</html>

